/* =========================================================
   DAVKAYS PREMIUM HERO BRAND MARK
   Inline SVG — no external image required
   ========================================================= */

.dk-premium-logo-visual {
  min-height: 500px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: relative;
  transform: translateY(-42px);
}

.dk-premium-logo {
  width: 430px;
  height: 430px;
  position: relative;
  display: grid;
  place-items: center;
  animation: dkLogoFloat 6s ease-in-out infinite;
}

.dk-logo-aura {
  position: absolute;
  width: 300px;
  height: 300px;
  border-radius: 50%;
  background:
    radial-gradient(
      circle,
      rgba(24, 116, 255, 0.28) 0%,
      rgba(20, 92, 255, 0.12) 38%,
      rgba(0, 0, 0, 0) 72%
    );
  filter: blur(18px);
  z-index: 0;
}

.dk-brand-svg {
  width: 360px;
  height: 360px;
  position: relative;
  z-index: 5;
  overflow: visible;
  filter:
    drop-shadow(0 0 10px rgba(34, 137, 255, 0.28))
    drop-shadow(0 0 30px rgba(31, 93, 255, 0.18));
}

.dk-logo-orbit {
  position: absolute;
  border-radius: 50%;
  pointer-events: none;
  z-index: 2;
}

.orbit-one {
  width: 390px;
  height: 122px;
  border: 1px solid rgba(54, 151, 255, 0.30);
  transform: rotate(-20deg);
  box-shadow: 0 0 20px rgba(35, 125, 255, 0.08);
}

.orbit-two {
  width: 355px;
  height: 108px;
  border: 1px solid rgba(92, 89, 255, 0.22);
  transform: rotate(28deg);
}

.dk-logo-bottom-glow {
  position: absolute;
  width: 220px;
  height: 30px;
  bottom: 28px;
  left: 50%;
  transform: translateX(-50%);
  border-radius: 50%;
  background: rgba(22, 126, 255, 0.42);
  filter: blur(20px);
  z-index: 1;
}

.dk-premium-wordmark {
  position: relative;
  z-index: 10;
  margin-top: -45px;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 5px;
}

.dk-premium-wordmark strong {
  color: #e9f2ff;
  font-size: 20px;
  font-weight: 700;
  letter-spacing: -0.5px;
  text-shadow:
    0 0 12px rgba(70, 153, 255, 0.28);
}

.dk-premium-wordmark strong span {
  color: #29bfff;
}

.dk-premium-wordmark small {
  color: #7189b2;
  font-size: 8px;
  font-weight: 700;
  letter-spacing: 5px;
}

@keyframes dkLogoFloat {
  0%,
  100% {
    transform: translateY(0);
  }

  50% {
    transform: translateY(-8px);
  }
}

@media (max-width: 900px) {
  .dk-premium-logo-visual {
    min-height: 410px;
    transform: translateY(-15px);
  }


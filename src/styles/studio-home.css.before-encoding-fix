.dk-studio-home {
  --dk-bg: #050914;
  --dk-panel: rgba(9, 17, 34, 0.78);
  --dk-panel-strong: #0a1328;
  --dk-border: rgba(93, 130, 205, 0.2);
  --dk-border-bright: rgba(75, 150, 255, 0.48);
  --dk-text: #edf4ff;
  --dk-muted: #8292ad;
  --dk-blue: #4ca8ff;
  --dk-cyan: #45d8ff;
  --dk-purple: #866bff;
  position: relative;
  overflow: hidden;
  background: var(--dk-bg);
  color: var(--dk-text);
}

.dk-shell {
  width: min(1180px, calc(100% - 44px));
  margin: 0 auto;
}

.dk-section {
  position: relative;
  padding: 120px 0;
}

.dk-hero {
  position: relative;
  min-height: 820px;
  display: flex;
  align-items: center;
  padding: 120px 0 90px;
  overflow: hidden;
  background:
    radial-gradient(circle at 78% 45%, rgba(49, 105, 255, 0.15), transparent 30%),
    radial-gradient(circle at 20% 75%, rgba(67, 197, 255, 0.07), transparent 28%),
    #050914;
}

.dk-hero-grid,
.dk-cta-grid {
  position: absolute;
  inset: 0;
  opacity: 0.34;
  background-image:
    linear-gradient(rgba(91, 133, 211, 0.07) 1px, transparent 1px),
    linear-gradient(90deg, rgba(91, 133, 211, 0.07) 1px, transparent 1px);
  background-size: 54px 54px;
  mask-image: linear-gradient(to bottom, black, transparent 92%);
}

.dk-hero-orb,
.dk-cta-orb {
  position: absolute;
  border-radius: 50%;
  filter: blur(80px);
  pointer-events: none;
}

.dk-orb-left {
  width: 280px;
  height: 280px;
  left: -180px;
  bottom: 80px;
  background: rgba(0, 132, 255, 0.13);
}

.dk-orb-right {
  width: 380px;
  height: 380px;
  right: -220px;
  top: 120px;
  background: rgba(117, 65, 255, 0.13);
}

.dk-hero-layout {
  position: relative;
  z-index: 2;
  display: grid;
  grid-template-columns: 0.88fr 1.12fr;
  gap: 62px;
  align-items: center;
}

.dk-eyebrow,
.dk-section-kicker {
  display: inline-flex;
  align-items: center;
  gap: 9px;
  color: #5eb9ff;
  font-size: 10px;
  font-weight: 800;
  letter-spacing: 2px;
  text-transform: uppercase;
}

.dk-eyebrow-dot {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: #4dff9a;
  box-shadow: 0 0 12px rgba(77, 255, 154, 0.8);
}

.dk-hero-copy h1 {
  margin: 23px 0 25px;
  max-width: 700px;
  color: #f0f5ff;
  font-size: clamp(46px, 5.3vw, 77px);
  line-height: 0.98;
  letter-spacing: -3.8px;
  font-weight: 800;
}

.dk-gradient-text {
  background: linear-gradient(100deg, #f2f7ff 0%, #54baff 45%, #8270ff 100%);
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
}

.dk-hero-copy > p {
  max-width: 620px;
  margin: 0;
  color: #8b9bb7;
  font-size: 16px;
  line-height: 1.75;
}

.dk-hero-actions {
  display: flex;
  align-items: center;
  gap: 12px;
  margin-top: 30px;
}

.dk-primary-button,
.dk-secondary-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 9px;
  min-height: 46px;
  padding: 0 18px;
  border-radius: 9px;
  font-size: 12px;
  font-weight: 700;
  transition: 0.25s ease;
}

.dk-primary-button {
  color: white;
  border: 1px solid rgba(112, 181, 255, 0.65);
  background: linear-gradient(110deg, #149fe9, #6959f4);
  box-shadow: 0 12px 34px rgba(47, 110, 255, 0.18);
}

.dk-primary-button:hover {
  transform: translateY(-2px);
  box-shadow: 0 15px 38px rgba(47, 110, 255, 0.3);
}

.dk-secondary-button {
  color: #b6c7e5;
  border: 1px solid rgba(104, 133, 188, 0.27);
  background: rgba(11, 22, 44, 0.6);
}

.dk-secondary-button:hover {
  color: white;
  border-color: rgba(81, 157, 255, 0.6);
  background: rgba(24, 48, 91, 0.62);
  transform: translateY(-2px);
}

.dk-capability-line {
  display: flex;
  flex-wrap: wrap;
  gap: 17px;
  margin-top: 25px;
}

.dk-capability-line span,
.dk-cta-capabilities span {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  color: #647793;
  font-size: 10px;
  font-weight: 700;
}

.dk-capability-line svg,
.dk-cta-capabilities svg {
  color: #54d8a0;
}

.dk-hero-visual {
  min-width: 0;
}

/* LOGO */

.dk-logo-mark {
  width: 36px;
  height: 36px;
  display: grid;
  place-items: center;
  flex-shrink: 0;
  border: 1px solid rgba(91, 154, 255, 0.7);
  border-radius: 50%;
  background: radial-gradient(circle, rgba(57, 125, 255, 0.18), rgba(7, 15, 31, 0.9));
  box-shadow:
    inset 0 0 18px rgba(55, 129, 255, 0.1),
    0 0 18px rgba(51, 126, 255, 0.12);
}

.dk-logo-mark span {
  color: #e9f3ff;
  font-size: 10px;
  font-weight: 900;
  letter-spacing: -0.5px;
}

/* VISUAL BASE */

.dk-project-visual {
  position: relative;
  min-height: 340px;
  overflow: hidden;
  border: 1px solid rgba(83, 125, 207, 0.23);
  border-radius: 17px;
  background:
    radial-gradient(circle at 50% 10%, rgba(51, 122, 255, 0.1), transparent 45%),
    #071021;
}

.dk-visual-glow {
  position: absolute;
  width: 220px;
  height: 220px;
  right: -100px;
  top: -100px;
  border-radius: 50%;
  background: rgba(56, 119, 255, 0.13);
  filter: blur(50px);
}

.dk-brand-mini {
  display: flex;
  align-items: center;
  gap: 9px;
}

.dk-brand-mini strong {
  color: #dce9ff;
  font-size: 11px;
}

.dk-brand-mini small {
  display: block;
  margin-top: 2px;
  color: #5e7190;
  font-size: 8px;
}

/* SCHOOL VISUAL */

.dk-school-visual {
  padding: 17px;
}

.dk-admin-window {
  position: relative;
  z-index: 2;
  overflow: hidden;
  border: 1px solid rgba(81, 145, 255, 0.42);
  border-radius: 13px;
  background: rgba(5, 12, 26, 0.94);
  box-shadow: 0 28px 70px rgba(0, 0, 0, 0.35);
}

.dk-window-header {
  height: 45px;
  display: flex;
  align-items: center;
  gap: 18px;
  padding: 0 13px;
  border-bottom: 1px solid rgba(91, 127, 191, 0.13);
}

.dk-window-header > .dk-brand-mini {
  min-width: 115px;
}

.dk-window-header .dk-logo-mark {
  width: 25px;
  height: 25px;
}

.dk-window-header .dk-logo-mark span {
  font-size: 7px;
}

.dk-window-title {
  flex: 1;
  color: #7190bd;
  font-size: 8px;
  font-weight: 800;
  letter-spacing: 1.1px;
}

.dk-secure-pill,
.dk-live-pill,
.dk-local-pill,
.dk-order-pill {
  display: inline-flex;
  align-items: center;
  gap: 5px;
  color: #62e6a2;
  font-size: 7px;
  font-weight: 800;
  letter-spacing: 0.8px;
}

.dk-secure-pill svg {
  color: #62b8ff;
}

.dk-admin-layout {
  display: grid;
  grid-template-columns: 145px 1fr;
  min-height: 260px;
}

.dk-admin-sidebar {
  padding: 14px 10px;
  border-right: 1px solid rgba(91, 127, 191, 0.13);
}

.dk-admin-profile {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-bottom: 17px;
  padding: 8px;
  border-radius: 7px;
  background: rgba(28, 53, 94, 0.3);
}

.dk-admin-avatar {
  width: 25px;
  height: 25px;
  display: grid;
  place-items: center;
  color: #62b7ff;
  border: 1px solid rgba(72, 144, 255, 0.3);
  border-radius: 7px;
}

.dk-admin-profile strong,
.dk-admin-profile small {
  display: block;
}

.dk-admin-profile strong {
  color: #b8cbe9;
  font-size: 8px;
}

.dk-admin-profile small {
  margin-top: 3px;
  color: #586b87;
  font-size: 7px;
}

.dk-admin-sidebar > span {
  display: block;
  padding: 8px;
  margin-bottom: 2px;
  color: #536783;
  font-size: 8px;
  border-radius: 6px;
}

.dk-admin-sidebar > .dk-nav-active {
  color: #d5e6ff;
  background: rgba(52, 116, 226, 0.18);
}

.dk-admin-main {
  padding: 17px;
}

.dk-admin-topline {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.dk-admin-topline small,
.dk-admin-topline strong {
  display: block;
}

.dk-admin-topline small {
  color: #55709b;
  font-size: 7px;
  letter-spacing: 1px;
  font-weight: 800;
}

.dk-admin-topline strong {
  margin-top: 5px;
  color: #dbe8ff;
  font-size: 15px;
}

.dk-status {
  display: flex;
  align-items: center;
  gap: 6px;
  color: #5dba91;
  font-size: 7px;
}

.dk-status i,
.dk-live-pill i,
.dk-local-pill i {
  width: 5px;
  height: 5px;
  border-radius: 50%;
  background: #54e99d;
  box-shadow: 0 0 9px rgba(84, 233, 157, 0.7);
}

.dk-admin-stats {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 8px;
  margin-top: 15px;
}

.dk-admin-stats > div {
  padding: 11px;
  border: 1px solid rgba(87, 128, 194, 0.14);
  border-radius: 8px;
  background: rgba(12, 24, 47, 0.62);
}

.dk-admin-stats small,
.dk-admin-stats strong,
.dk-admin-stats span {
  display: block;
}

.dk-admin-stats small {
  color: #536b8d;
  font-size: 6px;
  letter-spacing: 1px;
}

.dk-admin-stats strong {
  margin-top: 6px;
  color: #e2edff;
  font-size: 10px;
}

.dk-admin-stats span {
  display: flex;
  align-items: center;
  gap: 4px;
  margin-top: 5px;
  color: #627794;
  font-size: 6px;
}

.dk-admin-stats span svg {
  color: #58cfa1;
}

.dk-admin-panels {
  display: grid;
  grid-template-columns: 1.45fr 0.8fr;
  gap: 8px;
  margin-top: 8px;
}

.dk-admin-chart,
.dk-admin-activity {
  min-height: 105px;
  padding: 10px;
  border: 1px solid rgba(87, 128, 194, 0.14);
  border-radius: 8px;
  background: rgba(12, 24, 47, 0.48);
}

.dk-panel-heading {
  display: flex;
  justify-content: space-between;
  gap: 10px;
}

.dk-panel-heading span {
  color: #a4b8d7;
  font-size: 7px;
  font-weight: 700;
}

.dk-panel-heading small {
  color: #536986;
  font-size: 6px;
}

.dk-dashboard-lines {
  position: relative;
  height: 62px;
  margin-top: 8px;
  overflow: hidden;
  border-bottom: 1px solid rgba(94, 126, 178, 0.14);
}

.dk-dashboard-lines i {
  position: absolute;
  left: 0;
  right: 0;
  border-top: 1px dashed rgba(95, 130, 184, 0.1);
}

.dk-dashboard-lines i:nth-child(1) { top: 10px; }
.dk-dashboard-lines i:nth-child(2) { top: 25px; }
.dk-dashboard-lines i:nth-child(3) { top: 40px; }
.dk-dashboard-lines i:nth-child(4) { top: 55px; }
.dk-dashboard-lines i:nth-child(5) { top: 68px; }

.dk-dashboard-lines b {
  position: absolute;
  bottom: 0;
  width: 7px;
  border-radius: 3px 3px 0 0;
  background: linear-gradient(to top, #247dff, #5ecbff);
}

.dk-dashboard-lines b:nth-of-type(1) { left: 15%; height: 40%; }
.dk-dashboard-lines b:nth-of-type(2) { left: 32%; height: 63%; }
.dk-dashboard-lines b:nth-of-type(3) { left: 49%; height: 50%; }
.dk-dashboard-lines b:nth-of-type(4) { left: 66%; height: 78%; }
.dk-dashboard-lines b:nth-of-type(5) { left: 83%; height: 67%; }

.dk-activity-row {
  display: flex;
  align-items: center;
  gap: 6px;
  padding-top: 10px;
  color: #607492;
  font-size: 6px;
}

.dk-activity-row svg {
  color: #5ed6a3;
}

.dk-architecture-strip {
  position: relative;
  z-index: 3;
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: 6px;
  margin-top: 9px;
}

.dk-architecture-strip > div {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 5px;
  min-height: 36px;
  border: 1px solid rgba(81, 132, 216, 0.18);
  border-radius: 7px;
  background: rgba(8, 19, 39, 0.85);
}

.dk-architecture-strip svg {
  color: #55b8ff;
}

.dk-architecture-strip span {
  color: #6e83a2;
  font-size: 6px;
  font-weight: 800;
}

/* QUEUE */

.dk-queue-visual,
.dk-food-visual,
.dk-insight-visual {
  padding: 20px;
}

.dk-queue-header,
.dk-food-top,
.dk-insight-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  position: relative;
  z-index: 2;
}

.dk-queue-header .dk-logo-mark,
.dk-food-top .dk-logo-mark,
.dk-insight-header .dk-logo-mark {
  width: 29px;
  height: 29px;
}

.dk-queue-header .dk-logo-mark span,
.dk-food-top .dk-logo-mark span,
.dk-insight-header .dk-logo-mark span {
  font-size: 7px;
}

.dk-queue-body {
  position: relative;
  z-index: 2;
  display: grid;
  grid-template-columns: 0.8fr 1.2fr;
  gap: 12px;
  margin-top: 33px;
}

.dk-now-serving {
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: 20px;
  border: 1px solid rgba(80, 143, 239, 0.26);
  border-radius: 12px;
  background: linear-gradient(145deg, rgba(28, 70, 132, 0.27), rgba(8, 17, 35, 0.7));
}

.dk-now-serving small {
  color: #6384ad;
  font-size: 7px;
  letter-spacing: 1.2px;
  font-weight: 800;
}

.dk-now-serving strong {
  margin-top: 8px;
  color: #eff6ff;
  font-size: 38px;
  letter-spacing: -2px;
}

.dk-now-serving span {
  margin-top: 4px;
  color: #6c83a5;
  font-size: 9px;
}

.dk-queue-counters {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 7px;
}

.dk-queue-counters > div {
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: 12px;
  border: 1px solid rgba(81, 128, 199, 0.15);
  border-radius: 9px;
  background: rgba(10, 22, 43, 0.65);
}

.dk-queue-counters > .active {
  border-color: rgba(74, 153, 255, 0.5);
  background: rgba(31, 73, 139, 0.26);
  box-shadow: inset 0 0 25px rgba(46, 122, 255, 0.07);
}

.dk-queue-counters span {
  color: #55708f;
  font-size: 7px;
}

.dk-queue-counters strong {
  margin-top: 9px;
  color: #d9e8ff;
  font-size: 17px;
}

.dk-queue-counters small {
  margin-top: 4px;
  color: #5e7699;
  font-size: 7px;
}

.dk-queue-footer,
.dk-food-footer,
.dk-insight-footer {
  position: relative;
  z-index: 2;
  display: flex;
  gap: 15px;
  margin-top: 17px;
  padding-top: 12px;
  border-top: 1px solid rgba(87, 128, 194, 0.12);
}

.dk-queue-footer span,
.dk-insight-footer span {
  display: flex;
  align-items: center;
  gap: 5px;
  color: #5e7596;
  font-size: 7px;
}

.dk-queue-footer svg,
.dk-insight-footer svg {
  color: #4eaaff;
}

/* FOOD */

.dk-order-pill {
  color: #b7caff;
  padding: 6px 8px;
  border: 1px solid rgba(100, 139, 204, 0.18);
  border-radius: 6px;
}

.dk-food-content {
  position: relative;
  z-index: 2;
  display: grid;
  grid-template-columns: 1.05fr 0.95fr;
  gap: 13px;
  margin-top: 25px;
}

.dk-food-hero-card {
  min-height: 170px;
  padding: 20px;
  display: flex;
  flex-direction: column;
  justify-content: center;
  border-radius: 12px;
  background:
    linear-gradient(130deg, rgba(39, 91, 154, 0.42), rgba(25, 30, 67, 0.72)),
    radial-gradient(circle at 80% 20%, rgba(121, 91, 255, 0.22), transparent 45%);
}

.dk-food-hero-card > span {
  color: #67caff;
  font-size: 7px;
  letter-spacing: 1.4px;
  font-weight: 800;
}

.dk-food-hero-card strong {
  max-width: 220px;
  margin-top: 8px;
  color: #f0f5ff;
  font-size: 24px;
  line-height: 1.05;
  letter-spacing: -1px;
}

.dk-food-hero-card small {
  max-width: 220px;
  margin-top: 8px;
  color: #8fa3c1;
  font-size: 8px;
  line-height: 1.5;
}

.dk-food-button {
  display: inline-flex;
  align-items: center;
  gap: 5px;
  width: max-content;
  margin-top: 13px;
  padding: 7px 9px;
  border-radius: 6px;
  color: white;
  font-size: 7px;
  font-weight: 700;
  background: rgba(35, 145, 235, 0.7);
}

.dk-food-items {
  display: flex;
  flex-direction: column;
  gap: 7px;
}

.dk-food-item {
  display: flex;
  align-items: center;
  gap: 9px;
  padding: 8px;
  border: 1px solid rgba(87, 128, 194, 0.13);
  border-radius: 9px;
  background: rgba(9, 20, 40, 0.66);
}

.dk-food-image {
  width: 45px;
  height: 45px;
  display: grid;
  place-items: center;
  border-radius: 8px;
  font-size: 20px;
}

.food-one { background: rgba(255, 146, 69, 0.15); }
.food-two { background: rgba(255, 82, 109, 0.12); }
.food-three { background: rgba(57, 181, 255, 0.12); }

.dk-food-item strong,
.dk-food-item small {
  display: block;
}

.dk-food-item strong {
  color: #cddcf1;
  font-size: 8px;
}

.dk-food-item small {
  margin-top: 4px;
  color: #5d7697;
  font-size: 7px;
}

.dk-food-footer {
  color: #5bd59b;
  font-size: 7px;
}

/* INSIGHTFORGE */

.dk-local-pill {
  padding: 6px 8px;
  border: 1px solid rgba(78, 212, 159, 0.18);
  border-radius: 6px;
}

.dk-insight-layout {
  position: relative;
  z-index: 2;
  display: grid;
  grid-template-columns: 105px 1fr;
  min-height: 220px;
  margin-top: 20px;
  overflow: hidden;
  border: 1px solid rgba(83, 126, 199, 0.14);
  border-radius: 10px;
  background: rgba(5, 13, 27, 0.7);
}

.dk-insight-layout aside {
  padding: 12px 8px;
  border-right: 1px solid rgba(86, 126, 188, 0.12);
}

.dk-insight-layout aside span {
  display: block;
  padding: 7px;
  margin-bottom: 2px;
  border-radius: 5px;
  color: #566e90;
  font-size: 7px;
}

.dk-insight-layout aside .active {
  color: #cfe2ff;
  background: rgba(47, 113, 221, 0.18);
}

.dk-insight-main {
  padding: 13px;
}

.dk-insight-title small,
.dk-insight-title strong {
  display: block;
}

.dk-insight-title small {
  color: #537198;
  font-size: 6px;
  letter-spacing: 1px;
}

.dk-insight-title strong {
  margin-top: 4px;
  color: #dceaff;
  font-size: 14px;
}

.dk-insight-cards {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 6px;
  margin-top: 10px;
}

.dk-insight-cards > div {
  padding: 8px;
  border: 1px solid rgba(81, 127, 197, 0.13);
  border-radius: 6px;
  background: rgba(15, 30, 57, 0.55);
}

.dk-insight-cards svg {
  color: #55baff;
}

.dk-insight-cards small,
.dk-insight-cards strong {
  display: block;
}

.dk-insight-cards small {
  margin-top: 5px;
  color: #536b8b;
  font-size: 6px;
}

.dk-insight-cards strong {
  margin-top: 3px;
  color: #d6e7ff;
  font-size: 8px;
}

.dk-insight-chart {
  margin-top: 7px;
  padding: 8px;
  border: 1px solid rgba(81, 127, 197, 0.13);
  border-radius: 6px;
}

.dk-bar-chart {
  height: 72px;
  display: flex;
  align-items: flex-end;
  gap: 9px;
  margin-top: 8px;
  padding: 0 9px;
  border-bottom: 1px solid rgba(89, 128, 183, 0.15);
}

.dk-bar-chart i {
  flex: 1;
  min-width: 7px;
  border-radius: 3px 3px 0 0;
  background: linear-gradient(to top, #267cff, #62d1ff);
  opacity: 0.85;
}

.dk-insight-footer {
  margin-top: 10px;
}

/* HEADINGS */

.dk-section-heading {
  display: grid;
  grid-template-columns: 1.1fr 0.9fr;
  align-items: end;
  gap: 60px;
  margin-bottom: 54px;
}

.dk-section-heading h2,
.dk-process-heading h2,
.dk-stack-copy h2,
.dk-about-copy h2,
.dk-final-cta h2,
.dk-lab-copy h2 {
  margin: 15px 0 0;
  color: #eef5ff;
  font-size: clamp(38px, 4.4vw, 60px);
  line-height: 1;
  letter-spacing: -2.5px;
}

.dk-section-heading h2 span,
.dk-process-heading h2 span,
.dk-stack-copy h2 span,
.dk-about-copy h2 span,
.dk-final-cta h2 span,
.dk-lab-copy h2 span {
  color: #559eff;
}

.dk-section-heading > p,
.dk-process-heading > p,
.dk-stack-copy > p,
.dk-about-copy > p,
.dk-lab-copy > p,
.dk-final-cta > p {
  color: #7e90ac;
  font-size: 14px;
  line-height: 1.8;
}

.dk-section-brand {
  display: flex;
  align-items: center;
  gap: 9px;
  margin-top: 22px;
}

.dk-section-brand .dk-logo-mark {
  width: 31px;
  height: 31px;
}

.dk-section-brand .dk-logo-mark span {
  font-size: 8px;
}

.dk-section-brand span {
  color: #607898;
  font-size: 8px;
  letter-spacing: 1.5px;
  font-weight: 800;
}

/* SERVICES */

.dk-service-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 11px;
}

.dk-service-card {
  position: relative;
  min-height: 215px;
  padding: 24px;
  border: 1px solid rgba(84, 122, 189, 0.16);
  border-radius: 12px;
  background: linear-gradient(145deg, rgba(10, 21, 42, 0.9), rgba(7, 14, 29, 0.7));
  transition: 0.25s ease;
}

.dk-service-card:hover {
  transform: translateY(-4px);
  border-color: rgba(69, 143, 255, 0.4);
  box-shadow: 0 18px 45px rgba(0, 0, 0, 0.2);
}

.dk-service-icon {
  width: 38px;
  height: 38px;
  display: grid;
  place-items: center;
  color: #5ab8ff;
  border: 1px solid rgba(77, 145, 235, 0.2);
  border-radius: 9px;
  background: rgba(47, 118, 227, 0.09);
}

.dk-service-card h3 {
  margin: 21px 0 9px;
  color: #dce8fa;
  font-size: 15px;
}

.dk-service-card p {
  margin: 0;
  color: #687c9b;
  font-size: 11px;
  line-height: 1.7;
}

.dk-service-card a {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  margin-top: 20px;
  color: #629edc;
  font-size: 10px;
  font-weight: 700;
}

.dk-anything-banner {
  display: flex;
  align-items: center;
  gap: 17px;
  margin-top: 13px;
  padding: 20px 22px;
  border: 1px solid rgba(75, 139, 231, 0.24);
  border-radius: 12px;
  background:
    linear-gradient(90deg, rgba(34, 91, 173, 0.15), rgba(84, 72, 198, 0.1)),
    rgba(8, 18, 37, 0.7);
}

.dk-anything-icon {
  width: 42px;
  height: 42px;
  display: grid;
  place-items: center;
  flex-shrink: 0;
  color: #68c4ff;
  border-radius: 10px;
  background: rgba(62, 143, 241, 0.12);
}

.dk-anything-banner > div:nth-child(2) {
  flex: 1;
}

.dk-anything-banner span {
  display: block;
  color: #54749e;
  font-size: 7px;
  font-weight: 800;
  letter-spacing: 1.2px;
}

.dk-anything-banner strong {
  display: block;
  margin-top: 4px;
  color: #dceaff;
  font-size: 14px;
}

.dk-anything-banner strong em {
  color: #55adff;
  font-style: normal;
}

.dk-anything-banner p {
  margin: 5px 0 0;
  color: #697e9d;
  font-size: 9px;
}

.dk-anything-banner > a {
  display: inline-flex;
  align-items: center;
  gap: 7px;
  flex-shrink: 0;
  color: #83bbff;
  font-size: 10px;
  font-weight: 700;
}

/* PROJECTS */

.dk-work-section {
  background: linear-gradient(180deg, #050914, #060b17);
}

.dk-work-heading {
  margin-bottom: 48px;
}

.dk-project-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 15px;
}

.dk-project-card {
  overflow: hidden;
  border: 1px solid rgba(84, 122, 189, 0.17);
  border-radius: 15px;
  background: rgba(8, 17, 34, 0.72);
  transition: 0.28s ease;
}

.dk-project-card:hover {
  transform: translateY(-5px);
  border-color: rgba(73, 145, 248, 0.42);
  box-shadow: 0 25px 60px rgba(0, 0, 0, 0.25);
}

.dk-project-body {
  padding: 22px;
}

.dk-project-meta {
  display: flex;
  justify-content: space-between;
  gap: 12px;
}

.dk-project-meta span {
  color: #5e7ca4;
  font-size: 8px;
  font-weight: 800;
  letter-spacing: 0.9px;
  text-transform: uppercase;
}

.dk-project-meta span:last-child {
  color: #59bd98;
}

.dk-project-body h3 {
  margin: 12px 0 8px;
  color: #e4edfc;
  font-size: 21px;
  letter-spacing: -0.5px;
}

.dk-project-body p {
  margin: 0;
  color: #7185a3;
  font-size: 11px;
  line-height: 1.75;
}

.dk-project-tech {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
  margin-top: 16px;
}

.dk-project-tech span {
  padding: 5px 7px;
  color: #6f9ad0;
  border: 1px solid rgba(74, 126, 202, 0.17);
  border-radius: 5px;
  background: rgba(31, 70, 125, 0.1);
  font-size: 8px;
  font-weight: 700;
}

.dk-text-link {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  margin-top: 17px;
  color: #6eaff6;
  font-size: 10px;
  font-weight: 700;
}

/* PROCESS */

.dk-process-section {
  background:
    radial-gradient(circle at 50% 50%, rgba(47, 106, 220, 0.08), transparent 35%),
    #060b17;
}

.dk-process-heading {
  max-width: 700px;
  margin-bottom: 55px;
}

.dk-process-grid {
  display: grid;
  grid-template-columns: repeat(6, 1fr);
  gap: 8px;
}

.dk-process-step {
  position: relative;
  min-height: 205px;
  padding: 17px;
  border: 1px solid rgba(81, 121, 188, 0.14);
  border-radius: 10px;
  background: rgba(8, 18, 36, 0.65);
}

.dk-process-icon {
  width: 34px;
  height: 34px;
  display: grid;
  place-items: center;
  color: #59b8ff;
  border: 1px solid rgba(75, 143, 230, 0.19);
  border-radius: 8px;
  background: rgba(50, 119, 220, 0.08);
}

.dk-process-number {
  display: block;
  margin-top: 17px;
  color: #3d5778;
  font-size: 8px;
  font-weight: 800;
}

.dk-process-step h3 {
  margin: 7px 0;
  color: #d8e6fa;
  font-size: 13px;
}

.dk-process-step p {
  margin: 0;
  color: #617590;
  font-size: 9px;
  line-height: 1.65;
}

.dk-process-arrow {
  position: absolute;
  right: -14px;
  top: 48%;
  z-index: 3;
  color: #4e72a0;
}

/* STACK */

.dk-stack-section {
  border-top: 1px solid rgba(81, 121, 188, 0.08);
  background: #050a15;
}

.dk-stack-layout {
  display: grid;
  grid-template-columns: 0.85fr 1.15fr;
  gap: 80px;
  align-items: start;
}

.dk-stack-flow {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 9px;
  margin-top: 26px;
  color: #5d9ad0;
  font-size: 9px;
  font-weight: 800;
}

.dk-stack-flow svg {
  color: #405b7c;
}

.dk-stack-groups {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 9px;
}

.dk-stack-group {
  padding: 17px;
  border: 1px solid rgba(81, 121, 188, 0.15);
  border-radius: 10px;
  background: rgba(9, 18, 36, 0.7);
}

.dk-stack-group h3 {
  display: flex;
  align-items: center;
  gap: 7px;
  margin: 0 0 12px;
  color: #b9cbe4;
  font-size: 10px;
}

.dk-stack-group h3 svg {
  color: #55b7ff;
}

.dk-stack-group > div {
  display: flex;
  flex-wrap: wrap;
  gap: 5px;
}

.dk-stack-group span {
  padding: 5px 7px;
  border: 1px solid rgba(81, 126, 192, 0.14);
  border-radius: 5px;
  color: #6e85a5;
  background: rgba(26, 53, 91, 0.12);
  font-size: 8px;
}

/* LAB */

.dk-lab-section {
  padding-top: 30px;
}

.dk-lab-card {
  position: relative;
  display: grid;
  grid-template-columns: 0.9fr 1.1fr;
  gap: 50px;
  overflow: hidden;
  padding: 48px;
  border: 1px solid rgba(84, 132, 215, 0.2);
  border-radius: 17px;
  background:
    linear-gradient(120deg, rgba(18, 40, 78, 0.6), rgba(12, 20, 44, 0.76)),
    #080f20;
}

.dk-lab-glow {
  position: absolute;
  width: 380px;
  height: 380px;
  right: -150px;
  top: -170px;
  border-radius: 50%;
  background: rgba(79, 79, 255, 0.13);
  filter: blur(60px);
}

.dk-lab-copy,
.dk-lab-items {
  position: relative;
  z-index: 2;
}

.dk-lab-copy h2 {
  font-size: 48px;
}

.dk-lab-copy .dk-secondary-button {
  margin-top: 25px;
}

.dk-lab-items {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.dk-lab-item {
  display: flex;
  align-items: center;
  gap: 11px;
  padding: 13px;
  border: 1px solid rgba(83, 126, 196, 0.14);
  border-radius: 9px;
  background: rgba(6, 14, 29, 0.6);
}

.dk-lab-icon {
  width: 35px;
  height: 35px;
  display: grid;
  place-items: center;
  flex-shrink: 0;
  color: #5cbaff;
  border-radius: 8px;
  background: rgba(44, 116, 217, 0.11);
}

.dk-lab-item > div {
  flex: 1;
}

.dk-lab-item strong,
.dk-lab-item small {
  display: block;
}

.dk-lab-item strong {
  color: #d5e3f8;
  font-size: 10px;
}

.dk-lab-item small {
  margin-top: 4px;
  color: #627895;
  font-size: 8px;
}

.dk-lab-tag {
  padding: 5px 7px;
  color: #6d9ed2;
  border: 1px solid rgba(78, 132, 211, 0.16);
  border-radius: 5px;
  font-size: 7px;
  font-weight: 800;
}

/* ABOUT */

.dk-about-section {
  background:
    radial-gradient(circle at 80% 50%, rgba(74, 84, 207, 0.08), transparent 28%),
    #050914;
}

.dk-about-layout {
  display: grid;
  grid-template-columns: 1fr 0.7fr;
  gap: 90px;
  align-items: center;
}

.dk-about-copy > p {
  max-width: 680px;
}

.dk-about-points {
  display: flex;
  flex-wrap: wrap;
  gap: 14px;
  margin-top: 22px;
}

.dk-about-points span {
  display: inline-flex;
  align-items: center;
  gap: 5px;
  color: #7187a7;
  font-size: 9px;
  font-weight: 700;
}

.dk-about-points svg {
  color: #54d59d;
}

.dk-about-highlight {
  min-height: 390px;
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: 42px;
  border: 1px solid rgba(81, 134, 221, 0.22);
  border-radius: 16px;
  background:
    radial-gradient(circle at 50% 0%, rgba(48, 113, 227, 0.18), transparent 45%),
    rgba(8, 17, 34, 0.76);
}

.dk-about-symbol {
  margin-bottom: 18px;
}

.dk-about-highlight > span {
  color: #5a83b4;
  font-size: 8px;
  font-weight: 800;
  letter-spacing: 1.4px;
}

.dk-about-highlight > strong {
  margin-top: 18px;
  color: #e9f2ff;
  font-size: 40px;
  line-height: 0.94;
  letter-spacing: -2px;
}

.dk-about-highlight p {
  max-width: 260px;
  margin: 20px 0 0;
  color: #6f84a3;
  font-size: 10px;
  line-height: 1.7;
}

.dk-about-line {
  display: flex;
  gap: 5px;
  margin-top: 25px;
}

.dk-about-line i {
  width: 30px;
  height: 2px;
  background: #347ff0;
}

.dk-about-line i:nth-child(2) {
  width: 16px;
  background: #56c6ff;
}

.dk-about-line i:nth-child(3) {
  width: 9px;
  background: #7667ef;
}

.dk-about-line i:nth-child(4) {
  width: 5px;
  background: #4e5e84;
}

/* CTA */

.dk-final-cta {
  position: relative;
  overflow: hidden;
  padding: 135px 0;
  text-align: center;
  background:
    radial-gradient(circle at 50% 60%, rgba(40, 101, 232, 0.16), transparent 35%),
    #050914;
}

.dk-cta-orb {
  width: 450px;
  height: 450px;
  left: calc(50% - 225px);
  top: 30px;
  background: rgba(65, 95, 255, 0.09);
}

.dk-cta-content {
  position: relative;
  z-index: 2;
}

.dk-cta-content .dk-section-kicker {
  justify-content: center;
}

.dk-final-cta h2 {
  font-size: clamp(50px, 6vw, 76px);
}

.dk-final-cta > p {
  max-width: 610px;
  margin: 23px auto 0;
}

.dk-cta-capabilities {
  display: flex;
  justify-content: center;
  flex-wrap: wrap;
  gap: 17px;
  margin-top: 25px;
}

.dk-final-cta .dk-hero-actions {
  justify-content: center;
}

/* RESPONSIVE */

@media (max-width: 1050px) {
  .dk-hero-layout {
    grid-template-columns: 1fr;
  }

  .dk-hero-copy {
    max-width: 750px;
  }

  .dk-hero-visual {
    max-width: 800px;
  }

  .dk-process-grid {
    grid-template-columns: repeat(3, 1fr);
  }

  .dk-process-arrow {
    display: none;
  }
}

@media (max-width: 850px) {
  .dk-section-heading,
  .dk-stack-layout,
  .dk-about-layout,
  .dk-lab-card {
    grid-template-columns: 1fr;
    gap: 35px;
  }

  .dk-service-grid {
    grid-template-columns: repeat(2, 1fr);
  }

  .dk-project-grid {
    grid-template-columns: 1fr;
  }

  .dk-about-highlight {
    min-height: 300px;
  }
}

@media (max-width: 650px) {
  .dk-shell {
    width: min(100% - 28px, 1180px);
  }

  .dk-section {
    padding: 80px 0;
  }

  .dk-hero {
    min-height: auto;
    padding: 95px 0 70px;
  }

  .dk-hero-copy h1 {
    font-size: clamp(40px, 12vw, 57px);
    letter-spacing: -2.8px;
  }

  .dk-hero-copy > p {
    font-size: 13px;
  }

  .dk-hero-actions {
    flex-wrap: wrap;
  }

  .dk-capability-line {
    gap: 10px;
  }

  .dk-project-visual {
    min-height: 300px;
  }

  .dk-admin-layout {
    grid-template-columns: 100px 1fr;
  }

  .dk-admin-sidebar {
    padding: 10px 7px;
  }

  .dk-admin-main {
    padding: 11px;
  }

  .dk-admin-panels {
    grid-template-columns: 1fr;
  }

  .dk-architecture-strip {
    grid-template-columns: repeat(3, 1fr);
  }

  .dk-architecture-strip > div:nth-child(4),
  .dk-architecture-strip > div:nth-child(5) {
    display: none;
  }

  .dk-service-grid,
  .dk-process-grid,
  .dk-stack-groups {
    grid-template-columns: 1fr;
  }

  .dk-anything-banner {
    align-items: flex-start;
    flex-wrap: wrap;
  }

  .dk-anything-banner > a {
    margin-left: 59px;
  }

  .dk-food-content,
  .dk-queue-body,
  .dk-insight-layout {
    grid-template-columns: 1fr;
  }

  .dk-queue-counters {
    display: none;
  }

  .dk-insight-layout {
    grid-template-columns: 82px 1fr;
  }

  .dk-lab-card {
    padding: 28px 20px;
  }

  .dk-lab-copy h2 {
    font-size: 38px;
  }

  .dk-about-highlight {
    padding: 30px;
  }

  .dk-final-cta {
    padding: 100px 0;
  }

  .dk-final-cta h2 {
    font-size: 48px;
  }
}
/* Hero DK logo */
.dk-hero-logo-only {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 460px;
}

.dk-hero-brand {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8px;
  position: relative;
}

.dk-hero-dk {
  width: 190px;
  height: 190px;
  border: 2px solid rgba(85, 145, 255, 0.9);
  border-radius: 50%;
  display: grid;
  place-items: center;
  color: #eaf2ff;
  font-size: 76px;
  font-weight: 800;
  letter-spacing: -7px;
  padding-right: 7px;
  text-shadow:
    0 0 12px rgba(85, 145, 255, 0.9),
    0 0 35px rgba(70, 110, 255, 0.5);
  box-shadow:
    0 0 25px rgba(50, 120, 255, 0.25),
    inset 0 0 25px rgba(50, 120, 255, 0.08);
  background: radial-gradient(

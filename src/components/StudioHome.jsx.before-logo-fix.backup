function ProjectVisual({ type }) {
  if (type === "school") return <SchoolVisual />;
  if (type === "queue") return <QueueVisual />;
  if (type === "food") return <FoodVisual />;
  return <InsightVisual />;
}

function ProjectCard({ project }) {
  return (
    <article className="dk-project-card">
      <ProjectVisual type={project.visual} />

      <div className="dk-project-body">
        <div className="dk-project-meta">
          <span>{project.category}</span>
          <span>{project.status}</span>
        </div>

        <h3>{project.title}</h3>

        <p>{project.description}</p>

        <div className="dk-project-tech">
          {project.technologies.map((technology) => (
            <span key={technology}>{technology}</span>
          ))}
        </div>

        <a className="dk-text-link" href="#contact">
          Discuss this project
          <ArrowUpRight size={15} />
        </a>
      </div>
    </article>
  );
}

